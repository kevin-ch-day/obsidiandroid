        "VIEW_DEFINITION": "select r . assessment_id as assessment_id , r . artifact_sha256 as artifact_sha256 , r . revision as revision , r . previous_assessment_id as previous_assessment_id , r . input_digest as input_digest , r . assessed_at_utc as assessed_at_utc , r . result_json as result_json , r . family_id as family_id , r . type_id as type_id , r . processing_status as processing_status from $self . core_assessment_revision r where ! exists ( select 1 from $self . core_assessment_revision newer where newer . artifact_sha256 = r . artifact_sha256 and newer . revision > r . revision limit 1 )",
